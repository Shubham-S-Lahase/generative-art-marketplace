# Frontend Development Configuration

# API Backend URL (for development proxy)
VITE_API_URL=http://localhost:8080

# WebSocket URL (for development proxy)
VITE_WS_URL=ws://localhost:8080

# Frontend Port
VITE_PORT=5173

# Note: In production, these would typically be set at build time
# or the frontend would be served from the same domain as the backend

